{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dashka-productivity",
  "compatibility_date": "2026-09-17",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dashka-productivity-db",
      "database_id": "21d9b871-3575-4ec0-aac8-61e521039a28"
    }
  ]
}